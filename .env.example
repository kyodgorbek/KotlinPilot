# ==================================================
# KotlinPilot Environment Configuration
# ==================================================

# AI Provider ("groq", "fake")
AI_PROVIDER=groq

# Groq API Configuration (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Target Workspace (absolute path to Kotlin/Android project to operate on)
PROJECT_WORKSPACE=

# Execution and Safety Limits
MAX_AGENT_ITERATIONS=20
COMMAND_TIMEOUT_SECONDS=120

# Agent Mode (EXPLAIN, ASSISTED, AUTONOMOUS)
AGENT_MODE=ASSISTED
